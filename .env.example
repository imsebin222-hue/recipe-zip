# Never put real secrets in frontend files or commit a .env file.
YOUTUBE_API_KEY=replace_with_new_restricted_youtube_key
OPENROUTER_API_KEY=replace_with_new_openrouter_key
# Any OpenRouter model ID, for example moonshotai/kimi-k2.6
OPENAI_MODEL=moonshotai/kimi-k2.6
PORT=3000
# Makes the app available to devices on the same Wi-Fi network.
HOST=0.0.0.0
